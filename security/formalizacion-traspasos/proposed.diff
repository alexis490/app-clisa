     // REGISTROS
     // =====================================================
 
+    // Formalizacion externa: solo tres campos, nunca estado del movimiento o pago.
+    function formalizacionInicialValida(r) {
+      return !r.keys().hasAny(['estadoFormalizacion','formalizadoEn','formalizadoPor'])
+        || (r.keys().hasAll(['estadoFormalizacion','formalizadoEn','formalizadoPor'])
+          && r.estadoFormalizacion == 'PENDIENTE' && r.formalizadoEn == null && r.formalizadoPor == null);
+    }
+    function formalizacionValida() {
+      let before = resource.data;
+      let after = request.resource.data;
+      return cuentaActiva() && esAdmin()
+        && before.tipo == 'SALIDA' && before.estado == 'COMPLETADO'
+        && before.tiendaOrigenId == 'clisa' && before.tiendaDestinoId == 'toqen'
+        && before.get('estadoFormalizacion','SIN_VERIFICAR') in ['PENDIENTE','SIN_VERIFICAR']
+        && before.get('formalizadoEn',null) == null && before.get('formalizadoPor',null) == null
+        && after.diff(before).affectedKeys().hasOnly(['estadoFormalizacion','formalizadoEn','formalizadoPor'])
+        && after.keys().hasAll(['estadoFormalizacion','formalizadoEn','formalizadoPor'])
+        && after.estadoFormalizacion == 'COMPLETADO'
+        && after.formalizadoPor is string && after.formalizadoPor == request.auth.uid
+        && after.formalizadoEn is timestamp && after.formalizadoEn == request.time;
+    }
+
     match /registros/{registroId} {
 
       allow read: if cuentaActiva();
